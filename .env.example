# --- Sanity (https://www.sanity.io/manage) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# API token with Editor rights. Server-only: never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Secrets for the two webhooks (any long random strings).
SANITY_REVALIDATE_SECRET=
SANITY_AI_WEBHOOK_SECRET=

# --- Users and sessions ---
# Long random string that signs session cookies (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
# Comma-separated emails that become administrators on registration.
# The very first registered account is an administrator anyway.
ADMIN_EMAILS=

# --- AI (optional bonus) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Public URL of the deployed site (sitemap, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site account of the demo content's author (npm run seed links their projects, topics and comments to it).
SEED_OWNER_EMAIL=
